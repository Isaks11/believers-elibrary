# Copy this file to `.env` and fill in real values.
# `.env` is gitignored — never commit secrets.

# --- Supabase (Project Settings > API) ---
# The app runs on device-local storage until these are set.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Admin access (frontend UX only; RLS is the real enforcement) ---
# Comma-separated emails granted the admin role at sign-in.
# Example: VITE_ADMIN_EMAILS=admin@example.com,team@example.com
# Leave empty and nobody gets admin access (secure default).
VITE_ADMIN_EMAILS=
