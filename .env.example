# Copy this file to `.env` and fill in real values.
# `.env` is gitignored — never commit secrets.

# --- Supabase (Project Settings > API) ---
# The app runs on device-local storage until these are set.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Admin access (frontend UX only; RLS is the real enforcement) ---
# Comma-separated emails granted the admin role at sign-in.
# Example: VITE_ADMIN_EMAILS=admin@example.com,team@example.com
# Leave empty and nobody gets admin access (secure default).
VITE_ADMIN_EMAILS=

# --- Demo administrator (device-local only) ---
# Signs in as a local admin with no Supabase session (no profiles row, no RLS
# privileges). Intended for demos and Admin CMS review only.
#
# `npm run dev` uses the built-in demo account automatically (no setup needed):
#   demo.admin@believerslibrary.com / DemoAdmin2026!
# Set VITE_DEMO_ADMIN_ENABLED=false to disable it, or fill in the values below
# to use different credentials.
#
# Production builds have NO demo account unless VITE_DEMO_ADMIN_ENABLED=true is
# supplied at build time — keep it disabled on any deployed environment.
VITE_DEMO_ADMIN_ENABLED=
VITE_DEMO_ADMIN_EMAIL=
VITE_DEMO_ADMIN_PASSWORD=
VITE_DEMO_ADMIN_NAME=
