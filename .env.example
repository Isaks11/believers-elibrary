# Copy this file to `.env` and fill in real values.
# `.env` is gitignored — never commit secrets.

# --- Supabase (Project Settings > API) ---
# The app runs on device-local storage until these are set.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Admin access (frontend UX only; RLS is the real enforcement) ---
# Comma-separated emails granted the admin role at sign-in.
# Example: VITE_ADMIN_EMAILS=admin@example.com,team@example.com
# Leave empty and nobody gets admin access (secure default).
VITE_ADMIN_EMAILS=

# --- Demo administrator (device-local only; DISABLED by default) ---
# When enabled, the email/password below sign in as a local admin with no
# Supabase session (no profiles row, no RLS privileges). Intended for demos and
# Admin CMS review only — leave VITE_DEMO_ADMIN_ENABLED empty or false on any
# deployed environment.
# Example:
#   VITE_DEMO_ADMIN_ENABLED=true
#   VITE_DEMO_ADMIN_EMAIL=demo.admin@believerslibrary.com
#   VITE_DEMO_ADMIN_PASSWORD=choose-a-demo-password
#   VITE_DEMO_ADMIN_NAME=Demo Admin
VITE_DEMO_ADMIN_ENABLED=
VITE_DEMO_ADMIN_EMAIL=
VITE_DEMO_ADMIN_PASSWORD=
VITE_DEMO_ADMIN_NAME=
